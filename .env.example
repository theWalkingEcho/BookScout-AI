# ---------------------------------------------------------------------------
# Neo4j Database Connection
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j_uri
NEO4J_USER=username
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=bookstore-inventory

# ---------------------------------------------------------------------------
# Google Gemini AI Settings
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TEMPERATURE=0.2
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=3072
SEMANTIC_SEARCH_TOP_K=15

# ---------------------------------------------------------------------------
# Scraper Settings
# ---------------------------------------------------------------------------
SCRAPE_LIMIT=None
SCRAPE_BATCH_SIZE=50
SCRAPE_WORKERS=8

# ---------------------------------------------------------------------------
# Bookstore Configs (JSON array format)
# ---------------------------------------------------------------------------
STORE_CONFIGS_JSON='[
    {
        "name": "Example Store 1", 
        "base_url": "https://store-1.lk", 
        "currency": "LKR"
    },
    {
        "name": "Example Store 2", 
        "base_url": "https://store-2.lk", 
        "currency": "LKR"
    }
]'

# ---------------------------------------------------------------------------
# Application & Frontend Settings
# ---------------------------------------------------------------------------
API_URL=http://localhost:8000
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false